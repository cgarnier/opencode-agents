{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/rules/git-safety.md",
    ".opencode/rules/code-quality.md"
  ],
  "small_model": "anthropic/claude-haiku-4-5",
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "*": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "orchestrator": {
      "model": "anthropic/claude-opus-5-5",
      "temperature": 0.2,
      "permission": {
        "bash": {
          "*": "allow"
        }
      }
    },
    "reviewer": {
      "model": "anthropic/claude-sonnet-5-5",
      "temperature": 0.1
    },
    "debugger": {
      "model": "anthropic/claude-opus-5-5",
      "temperature": 0.1
    },
    "tester": {
      "model": "anthropic/claude-sonnet-5-5",
      "temperature": 0.2
    },
    "refactorer": {
      "model": "anthropic/claude-sonnet-5-5",
      "temperature": 0.2
    },
    "performance": {
      "model": "anthropic/claude-sonnet-5-5",
      "temperature": 0.1
    },
    "security": {
      "model": "anthropic/claude-opus-5-5",
      "temperature": 0.1
    },
    "docs-writer": {
      "model": "anthropic/claude-sonnet-5-5",
      "temperature": 0.3
    },
    "git-publisher": {
      "model": "anthropic/claude-haiku-4-5",
      "temperature": 0.2
    },
    "mr-reviewer": {
      "model": "anthropic/claude-haiku-4-5",
      "temperature": 0.2
    }
  }
}
